{
  "schemaVersion": "ksib-theme-color-contract/1.0",
  "usageSchemaVersion": "ksib-theme-usage/1.1",
  "inventorySchemaVersion": "ksib-pptx-color-inventory/1.0",
  "defaultThemeId": "ksib-orange-teal",
  "palette": {
    "primary.dark": "#D83D00",
    "primary.base": "#FF4906",
    "primary.light": "#FFDBCD",
    "primary.pale": "#FFF7F3",
    "contrast.base": "#006B8F",
    "contrast.pale": "#E6F3F7",
    "neutral.textStrong": "#1F2329",
    "neutral.textMuted": "#646A73",
    "neutral.white": "#FFFFFF",
    "neutral.series": "#D9DCE1",
    "neutral.surface": "#FAFAFA",
    "neutral.divider": "#E5E6EB",
    "neutral.tableRule": "#AEB2BA",
    "neutral.surfaceSubtle": "#F5F6F7",
    "neutral.chartLabel": "#666666",
    "neutral.baselineStroke": "#B9BDC5",
    "status.positive": "#168A4B",
    "status.negative": "#C43D35",
    "status.warning": "#C98200"
  },
  "tokenGroups": {
    "primary": ["primary.dark", "primary.base", "primary.light", "primary.pale"],
    "contrast": ["contrast.base", "contrast.pale"],
    "neutral": ["neutral.textStrong", "neutral.textMuted", "neutral.white", "neutral.series", "neutral.surface", "neutral.divider", "neutral.tableRule", "neutral.surfaceSubtle", "neutral.chartLabel", "neutral.baselineStroke"],
    "status": ["status.positive", "status.negative", "status.warning"]
  },
  "allowedPurposes": {
    "primary.dark": ["focus", "hierarchy", "sequence-high", "total"],
    "primary.base": ["focus", "hierarchy", "sequence-mid", "action", "key-evidence"],
    "primary.light": ["sequence-low", "supporting-evidence", "band"],
    "primary.pale": ["surface", "band", "supporting-evidence"],
    "contrast.base": ["comparison", "counterpoint", "secondary-evidence"],
    "contrast.pale": ["comparison-surface", "counterpoint-surface"],
    "neutral.textStrong": ["text"],
    "neutral.textMuted": ["text", "annotation"],
    "neutral.white": ["text", "surface", "background"],
    "neutral.series": ["other", "baseline", "deemphasis", "reference", "underperformer"],
    "neutral.surface": ["surface", "background"],
    "neutral.divider": ["divider", "gridline"],
    "neutral.tableRule": ["divider", "table-rule"],
    "neutral.surfaceSubtle": ["surface", "band", "table-zebra"],
    "neutral.chartLabel": ["text", "axis-label"],
    "neutral.baselineStroke": ["axis", "baseline", "connector"],
    "status.positive": ["positive"],
    "status.negative": ["negative"],
    "status.warning": ["warning", "risk"]
  },
  "chartPatterns": [
    "no-data",
    "single-focus",
    "sequential",
    "two-way-comparison",
    "status-diverging",
    "categorical-limited"
  ],
  "rules": {
    "rawHexForbidden": true,
    "decorationPurposeForbidden": true,
    "neutralDataFillMustBeLight": true,
    "darkNeutralDataFillForbidden": true,
    "neutralCannotBeDominantEvidence": true,
    "maxChromaticDataGroupsPerSlide": 3,
    "minimumNormalTextContrast": 4.5,
    "minimumLargeTextContrast": 3.0,
    "exceptionsRequireUserApproval": true,
    "finalPptxInventoryRequired": true,
    "validatorLiveReExtractionRequired": true,
    "stableObjectNamesRequiredForColoredObjects": true,
    "everyVisibleColorBindingMustBeDeclaredExactlyOnce": true,
    "declaredTokenMustMatchResolvedPptxHex": true,
    "unresolvedVisibleColorsBlockDelivery": true
  },
  "customThemeDerivation": {
    "schemaVersion": "ksib-srgb-mix/1.0",
    "primaryDark": { "mixWith": "#000000", "weight": 0.15 },
    "primaryLight": { "mixWith": "#FFFFFF", "weight": 0.82 },
    "primaryPale": { "mixWith": "#FFFFFF", "weight": 0.95 },
    "contrastPale": { "mixWith": "#FFFFFF", "weight": 0.9 }
  }
}
