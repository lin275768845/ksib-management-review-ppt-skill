  "bodyStartPolicy": {
    "requireNamedAnchors": true
  },
  "hierarchy": {
    "roles": [
      "action-title",
      "subtitle",
      "takeaway"
    ],
    "similarityThreshold": 0.72
  },
  "takeawayPolicy": {
    "maxContentSlideRatio": 0.25,
    "maxConsecutive": 1,
    "requireNamedBottomTextBlocks": true,
    "bottomBandYIn": 6.2,
    "allowedBottomRoles": [
      "takeaway",
      "source-footnote",
      "page-number"
    ]
  },
