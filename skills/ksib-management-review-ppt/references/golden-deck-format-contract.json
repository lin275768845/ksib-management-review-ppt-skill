  "titlePolicy": {
    "scope": "content-action-title",
    "maxActionTitleLines": 1,
    "forbidExplicitLineBreaks": true,
    "forbidMultipleParagraphs": true,
    "maxWeightedCharacters": 38,
    "defaultTitleDividerPolicy": "forbid",
    "softWrapRequiresVisualGate": true
